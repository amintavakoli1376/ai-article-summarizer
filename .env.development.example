# ─── Development ──────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ─────────────────────────────────────────────
POSTGRES_DB=summarizer_dev
POSTGRES_USER=admin
POSTGRES_PASSWORD=development

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=development

# ─── URLs ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:development@postgres:5432/summarizer_dev
REDIS_URL=redis://:development@redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── API Keys (optional in dev) ───────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=